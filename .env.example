# Copy this file to ".env" and fill in your own values.
# The .env file is git-ignored and must NEVER be committed.

# --- AI ---
# "ollama" = fully local (needs Ollama + `ollama pull gemma3:4b`), "gemini" = Google cloud,
# "auto" = local when Ollama is running, otherwise Gemini.
AI_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here
# "gemini-flash-latest" tracks Google's current Flash model. Pin an exact id if needed.
GEMINI_MODEL=gemini-flash-latest

# --- Offline translation (optional) ---
# AI4Bharat IndicTrans2 translates walking directions and English sign text into your
# language, offline. One-time setup: log in at huggingface.co, accept the terms on
# https://huggingface.co/ai4bharat/indictrans2-en-indic-dist-200M , create a READ token
# (Settings -> Access Tokens), paste it here, then run: python -m visionai.translate --download
HF_TOKEN=

# --- Voice ---
# Voice output: "auto" (offline voices, else Google), "local" (offline only) or "gtts" (Google, online).
# Download the offline voices once with: python -m visionai.speech.tts --download
TTS_PROVIDER=auto
# Voice input (Whisper, runs locally): tiny | base | small | medium. Device: auto | cuda | cpu
STT_MODEL=small
STT_DEVICE=auto

# --- Vision ---
# Downloaded automatically on first run. yolo26n = fastest; yolo26s/m = more accurate.
YOLO_MODEL=yolo26n.pt
YOLO_CONF=0.35
# Path to the Tesseract OCR executable.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: usually just "tesseract"
TESSERACT_PATH=tesseract

# --- Navigation ---
# OpenRouteService API key (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=your_openrouteservice_api_key_here
# Fallback starting location (used when the device can't provide GPS):
DEFAULT_LAT=0.0
DEFAULT_LON=0.0
# Emergency contact for "Share my location" (country code + number, no +):
EMERGENCY_PHONE=

# --- API ---
MAX_UPLOAD_MB=5
# Comma-separated origins allowed to call the API (the React dev server by default)
CORS_ORIGINS=http://localhost:5173
